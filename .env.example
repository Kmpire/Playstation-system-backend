# Server Port (5001 avoids macOS AirPlay receiver conflict on 5000)
PORT=5001

# Environment: development | production
NODE_ENV=development

# Neon Database Connection String (PostgreSQL)
# Get this from your Neon console: https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_playstation_2026_dev
JWT_EXPIRES_IN=7d

# Frontend CORS Origin
CLIENT_ORIGIN=http://localhost:8443
